# Copier ce fichier vers .env et adapter les valeurs
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coupleplanner?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3000

# Clé API Google Gemini pour l'analyse vocale IA — palier GRATUIT
# Obtenir une clé : https://aistudio.google.com/app/apikey
# Si absente, le backend retombe sur le mock regex (utile en dev).
GEMINI_API_KEY=""
# Optionnel : surcharger le modèle (défaut : gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"
