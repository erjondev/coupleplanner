# Copier ce fichier vers .env et adapter les valeurs
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coupleplanner?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3000
# IP="0.0.0.0"          # requis par certains hébergeurs (ex: alwaysdata) — laisser vide en local

# Origines autorisées en CORS, séparées par des virgules (prod uniquement).
# Sans cette variable, toutes les origines sont autorisées (pratique en dev).
# CORS_ORIGIN="https://coupleplanner.alwaysdata.net"

# --- SMTP (envoi du code "mot de passe oublié") ---
# Si non configuré, le code est simplement loggé côté serveur (dev/dépannage),
# la fonctionnalité reste opérationnelle mais l'email n'est pas envoyé.
# Sur alwaysdata : créer un compte email (Panel > Emails) et réutiliser ses infos.
# SMTP_HOST="smtp-coupleplanner.alwaysdata.net"
# SMTP_PORT="587"
# SMTP_USER="noreply@coupleplanner.alwaysdata.net"
# SMTP_PASS="change-me"
# SMTP_FROM="CouplePlanner <noreply@coupleplanner.alwaysdata.net>"

# Clé API Google Gemini pour l'analyse vocale IA — palier GRATUIT
# Obtenir une clé : https://aistudio.google.com/app/apikey
# Si absente, le backend retombe sur le mock regex (utile en dev).
GEMINI_API_KEY=""
# Optionnel : surcharger le modèle (défaut : gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"
