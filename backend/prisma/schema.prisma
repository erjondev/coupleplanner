// Schéma Prisma - CouplePlanner
// Concept "3 espaces" :
//   - Mon Espace   -> Environment PRIVATE lié à un user
//   - Notre Espace -> Environment SHARED du couple (user_id = null)
//   - Son Espace   -> vue filtrée des tâches SHARED assignées au partenaire

generator client {
  provider = "prisma-client-js"
  // "native" = binaire pour la machine qui lance `prisma generate` (dev local).
  // Le serveur alwaysdata a "OpenSSL 3.0.20" en SSH, mais le bac d'exécution
  // réel des sites Node.js s'est avéré différent : Prisma y détecte
  // "debian-openssl-1.0.x" au runtime (constaté en prod, cf. DEPLOY.md).
  // On embarque les deux variantes pour ne pas dépendre de cette incohérence.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentType {
  PRIVATE
  SHARED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Statut de « proposition » d'une tâche : une activité proposée par un membre
// au partenaire n'apparaît dans l'agenda/les espaces qu'une fois ACCEPTED.
//   NONE     -> tâche normale (pas une proposition)
//   PENDING  -> proposée, en attente de validation du partenaire
//   ACCEPTED -> validée : devient une tâche commune visible partout
//   DECLINED -> refusée par le partenaire (visible seulement de l'émetteur)
enum ProposalStatus {
  NONE
  PENDING
  ACCEPTED
  DECLINED
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

model Couple {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  // Code court partagé au partenaire pour rejoindre le couple.
  // Nullable pour compat migration ; généré à la création via signup.
  inviteCode String? @unique @map("invite_code")

  users        User[]
  environments Environment[]

  @@map("couples")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  coupleId     String? @map("couple_id")
  // Jeton secret d'abonnement au flux ICS (URL privée collée dans Google/Apple
  // Agenda). Généré à la demande ; sa présence dans l'URL EST le contrôle d'accès
  // (les apps calendrier ne peuvent pas envoyer d'en-tête d'auth). Régénérable
  // pour révoquer un ancien lien.
  calendarFeedToken String? @unique @map("calendar_feed_token")
  // Réinitialisation de mot de passe : hash SHA-256 du code envoyé par email
  // (jamais le code en clair) + son expiration. Effacés après usage.
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  couple             Couple?             @relation(fields: [coupleId], references: [id])
  environments       Environment[]
  createdTasks       Task[]              @relation("TaskCreatedBy")
  assignedTasks      Task[]              @relation("TaskAssignedTo")
  notificationTokens NotificationToken[]

  @@map("users")
}

model Environment {
  id       String          @id @default(uuid())
  coupleId String          @map("couple_id")
  // null => espace commun du couple (SHARED)
  userId   String?         @map("user_id")
  type     EnvironmentType

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  tasks  Task[]

  @@map("environments")
}

model Task {
  id            String     @id @default(uuid())
  environmentId String     @map("environment_id")
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  startDatetime DateTime?  @map("start_datetime")
  endDatetime   DateTime?  @map("end_datetime")
  isAllDay      Boolean    @default(false) @map("is_all_day")
  createdBy     String     @map("created_by")
  assignedTo    String?    @map("assigned_to")
  // Proposition d'activité au partenaire (cf. enum ProposalStatus). Par défaut
  // NONE : les tâches ordinaires ne sont pas des propositions.
  proposalStatus ProposalStatus @default(NONE) @map("proposal_status")
  createdAt     DateTime   @default(now()) @map("created_at")

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  creator     User        @relation("TaskCreatedBy", fields: [createdBy], references: [id])
  assignee    User?       @relation("TaskAssignedTo", fields: [assignedTo], references: [id])

  @@index([environmentId, startDatetime])
  @@map("tasks")
}

model NotificationToken {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  token      String
  deviceType DeviceType @map("device_type")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("notification_tokens")
}
